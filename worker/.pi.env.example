# Pi / Node adapter environment (copy to worker/.pi.env — never commit secrets)
# systemd EnvironmentFile should point at /etc/airplane-frame/worker.env in production.

HOST=127.0.0.1
PORT=8788
FLIGHT_CACHE_PATH=/var/lib/airplane-frame/cache.json

CACHE_TTL_SECONDS=600
EMPTY_CACHE_TTL_SECONDS=60
STALE_TTL_SECONDS=3600
MAX_ATTEMPT=36
MAX_AIRLABS=5
MAX_RESULTS=20
PACK_SIZE=10

# Required secrets (leave blank in the example; fill on the Pi only)
AIRLABS_API_KEY=
APP_SHARED_SECRET=
