# Optional enrichment keys (positions work without any of these via airplanes.live)
# Copy to spike/.env and fill in after signup. Never commit .env.
# Also copy AIRLABS_API_KEY into worker/.dev.vars for local Wrangler (see docs/runbooks/secrets.md).

# OpenSky OAuth2 API client (from downloaded credentials.json) — optional, not MVP
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Required for locked stack enrichment (destination + airline name)
AIRLABS_API_KEY=
# AVIATIONSTACK_ACCESS_KEY=  # optional alternate; not used by Worker
